+    XPU = 3
+
+    @classmethod
+    def from_torch_device(cls, device: torch.device) -> "ComputeDevice":
+        device_types = {
+            "cpu": ComputeDevice.CPU,
+            "cuda": ComputeDevice.CUDA,
+            "mtia": ComputeDevice.MTIA,
+            "xpu": ComputeDevice.XPU,
+        }
+        try:
+            return device_types[device.type]
+        except KeyError as error:
