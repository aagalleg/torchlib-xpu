     ),
 }
@@ -152,6 +159,34 @@ def execute_backward_adagrad(  # noqa C901
     # Disable dynamo tests due to unknown failure
     assume(not compile)

+    # XPU only implements no-bag / unweighted / non-VBE / non-GWD / uniform-B
+    # rowwise Adagrad without cache, stochastic rounding, weight decay or
+    # max-norm.  Filter unsupported combos out of the hypothesis space.
+    if xpu_only and not use_cpu:
+        assume(pooling_mode == PoolingMode.NONE)
+        assume(row_wise)
+        assume(not weighted)
+        assume(not mixed)
+        assume(not mixed_B)
+        assume(not use_cache)
+        assume(not stochastic_rounding)
+        assume(weight_decay_mode == WeightDecayMode.NONE)
+        assume(max_norm == 0.0)
+        # PyTorch XPU autograd cannot backpropagate empty reference embeddings.
+        assume(L > 0)
+
+    # In the XPU-only environment the scoped CPU/accelerator strategy samples
+    # `use_cpu=True` cases too.
+    # The CPU wheel does not implement BF16 for the no-bag forward
+    # (`split_embedding_nobag_cpu_forward_1`), so filter that combo out.
+    if xpu_only and use_cpu:
+        assume(
+            not (
+                pooling_mode == PoolingMode.NONE
+                and output_dtype == SparseType.BF16
+            )
+        )
+
     emb_op = SplitTableBatchedEmbeddingBagsCodegen

     if pooling_mode == PoolingMode.SUM:
@@ -215,6 +250,9 @@ def execute_backward_adagrad(  # noqa C901
     elif use_cpu:
         managed = [EmbeddingLocation.HOST] * T
         compute_device = ComputeDevice.CPU
+    elif xpu_only:
+        managed = [EmbeddingLocation.DEVICE] * T
+        compute_device = ComputeDevice.XPU
     elif TEST_WITH_ROCM:
         # ROCm managed memory allocation is under development
         managed = [EmbeddingLocation.DEVICE] * T
@@ -280,6 +318,12 @@ def execute_backward_adagrad(  # noqa C901
             stochastic_rounding=stochastic_rounding,
             pooling_mode=pooling_mode,
             output_dtype=output_dtype,
+            device=current_accelerator() if xpu_only and not use_cpu else None,
+            bounds_check_mode=(
+                BoundsCheckMode.NONE
+                if xpu_only and not use_cpu
+                else BoundsCheckMode.WARNING
+            ),
         )
     )
     # TODO: make it compile for CPU and unweighted
@@ -488,6 +532,12 @@ def execute_backward_adagrad(  # noqa C901
     if tbe_op:
         return

+    # The per-sample-weights + gradcheck sub-block that follows re-instantiates
+    # the codegen module with `PoolingMode.SUM` (weighted route), which is not
+    # implemented on XPU.  Skip the remainder of the function on XPU.
+    if xpu_only and not use_cpu:
+        return
+
     # Free large tensors no longer needed before gradcheck to reduce GPU memory pressure
     del bs, bs_features, fs, gos, goc, fc2, ref_output
     del split_optimizer_states, get_optimizer_states, xs, xws
